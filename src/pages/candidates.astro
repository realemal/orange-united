---
import BaseLayout from '../layouts/BaseLayout.astro';
import CandidateProfile from '../components/CandidateProfile.astro';
import {
  areas,
  candidates,
  districtFacts,
  LAST_UPDATED,
  ELECTION_DATE,
  SOURCES,
} from '../data/election-2026';

const pageUrl = new URL('/candidates', Astro.site).toString();
const updatedLabel = new Date(`${LAST_UPDATED}T12:00:00`).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Orange Unified School Board Election 2026: Candidates, Voting Records and Statements',
  url: pageUrl,
  dateModified: LAST_UPDATED,
  about: {
    '@type': 'Event',
    name: 'Orange Unified School District Board of Education election',
    startDate: ELECTION_DATE,
    location: { '@type': 'Place', name: 'Orange Unified School District, Orange, California' },
  },
  publisher: { '@type': 'Organization', name: 'Orange United', url: Astro.site?.toString() },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: candidates.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Person',
        name: c.name,
        jobTitle: c.ballotDesignation,
        url: new URL(`/candidates/${c.slug}`, Astro.site).toString(),
        description: `${c.incumbent ? 'Incumbent' : 'Candidate'} for OUSD Board of Education, Trustee Area ${c.area}, November 3, 2026.`,
      },
    })),
  },
  citation: Object.values(SOURCES).map((s) => s.url),
};
---

<BaseLayout
  title="OUSD School Board Election 2026: Candidates and Voting Records"
  description="Every candidate for the Orange Unified School District board on the November 3, 2026 ballot (Trustee Areas 1, 4, 5 and 7), with each candidate's ballot statement and the incumbents' sourced voting record."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <section class="min-h-screen bg-blue-dark-600 py-10 sm:py-14 md:py-16">
    <div class="container-custom">
      <div class="max-w-6xl mx-auto space-y-10 md:space-y-12">
        <header class="max-w-2xl">
          <p class="text-white/80 text-xs font-bold uppercase tracking-widest mb-3">
            Election day: Tuesday, November 3, 2026
          </p>
          <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight leading-tight">
            Orange Unified School Board Election 2026: Candidates and Records
          </h1>
          <div class="h-1 w-20 bg-orange-500 mt-4" aria-hidden="true"></div>
          <p class="text-blue-100 text-base leading-relaxed mt-5">
            Four of the seven seats on the Orange Unified School District (OUSD) Board of Education are on the
            ballot: Trustee Areas 1, 4, 5 and 7. This page lists every candidate on the ballot in those areas. For
            each one we summarize the candidate's own ballot statement, and for incumbents we document their
            record on the board with links to the reporting behind it.
          </p>
          <p class="text-blue-200/80 text-xs mt-3">Last updated {updatedLabel}.</p>
        </header>

        <nav aria-label="Trustee areas" class="flex flex-wrap gap-2">
          {areas.map(({ area }) => (
            <a
              href={`#area-${area}`}
              class="border-2 border-white/80 text-white text-xs font-black uppercase tracking-wider px-3 py-2 hover:bg-white hover:text-gray-900 transition-colors"
            >
              Area {area}
            </a>
          ))}
          <a
            href="#district"
            class="border-2 border-white/40 text-white/90 text-xs font-black uppercase tracking-wider px-3 py-2 hover:bg-white hover:text-gray-900 transition-colors"
          >
            District facts
          </a>
        </nav>

        {areas.map(({ area, candidates: inArea }) => (
          <section id={`area-${area}`} class="scroll-mt-24">
            <div class="mb-4">
              <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">Trustee Area {area}</h2>
              <p class="text-blue-200/90 text-sm mt-1">
                {inArea.length} candidates: {inArea.map((c) => c.name).join(', ')}
              </p>
              <div class="h-1 bg-orange-500 mt-3 max-w-[6rem]" aria-hidden="true"></div>
            </div>
            <div class={`grid gap-4 ${inArea.length === 3 ? 'lg:grid-cols-3' : 'md:grid-cols-2'}`}>
              {inArea.map((c) => (
                <CandidateProfile candidate={c} />
              ))}
            </div>
          </section>
        ))}

        <section id="district" class="scroll-mt-24">
          <div class="mb-4">
            <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">District facts</h2>
            <div class="h-1 bg-orange-500 mt-3 max-w-[6rem]" aria-hidden="true"></div>
          </div>
          <dl class="bg-white border-2 border-gray-900 divide-y divide-gray-200">
            {districtFacts.map((f) => (
              <div class="p-4 sm:p-5">
                <dt class="text-sm font-bold text-gray-900">{f.topic}</dt>
                <dd class="text-sm text-gray-800 leading-relaxed mt-0.5">{f.text}</dd>
                <dd class="text-xs text-gray-500 mt-1">
                  Source:{' '}
                  {f.sources.map((s, i) => (
                    <>
                      {i > 0 && '; '}
                      <a href={s.url} class="underline hover:text-orange-600" rel="noopener" target="_blank">{s.label}</a>
                    </>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="max-w-2xl text-blue-100 text-sm leading-relaxed space-y-3 border-t border-white/15 pt-6">
          <h2 class="text-white font-black text-base">About this page</h2>
          <p>
            Ballot statement summaries are paraphrased from the statements candidates filed with the Orange County
            Registrar of Voters. Board records come from published news reporting, linked beside each item. Spot an
            error? Email <a class="underline" href="mailto:info@orangeunited.org">info@orangeunited.org</a> and we
            will correct it and note the change here.
          </p>
          <p>
            Check your registration, trustee area and polling place with the
            <a class="underline" href="https://www.ocvote.gov" rel="noopener" target="_blank">Orange County Registrar of Voters</a>.
          </p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
